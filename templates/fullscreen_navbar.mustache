{{!
    @template mod_onlyofficeeditor/fullscreen_navbar

    Navbar displayed above the editor in fullscreen mode.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="onlyofficeeditor-fullscreen-exit"

    Context variables required for this template:
    * documenttype - Document type of the editor config: word, cell, slide or pdf.

    Example context (json):
    {
        "documenttype": "word"
    }
}}
<div class="onlyofficeeditor-fullscreen-navbar" data-document-type="{{documenttype}}">
    <button type="button" class="btn btn-icon" data-action="onlyofficeeditor-fullscreen-exit"
            title="{{#str}} editorexitfullscreen, mod_onlyofficeeditor {{/str}}"
            aria-label="{{#str}} editorexitfullscreen, mod_onlyofficeeditor {{/str}}">
        {{#pix}} e/cancel, core {{/pix}}
    </button>
</div>
